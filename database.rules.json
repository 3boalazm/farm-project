{
  "rules": {

    // ══════════════════════════════════════════════════════════
    //  بيان المزرعة — Firebase Security Rules (Hardened)
    //  التطبيق يستخدم PIN login مخصص، لكن firebase.js دلوقتي بيضمن
    //  auth != null لأي جلسة (Anonymous Auth تلقائي + ربط حقيقي بعد
    //  نجاح الـPIN). القواعد هنا بترفض أي قراءة/كتابة من غير auth
    //  خالص، وتقصر finance/users/settings على admin فقط للكتابة.
    //
    //  ⚠️ لو رجّعت هذا الملف لنسخة ".read": true / ".write": true
    //  المفتوحة تاريخيًا، تأكد إن ده قرار متعمّد ومتزامن مع القواعد
    //  الفعلية المنشورة على Firebase Console -- رجوع هذا الملف وحده
    //  لا يغيّر أي حاجة على القاعدة الحقيقية المنشورة.
    // ══════════════════════════════════════════════════════════

    "animals": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChild('species') && newData.hasChild('breed') && newData.hasChild('gender')",
        "species": { ".validate": "newData.val() === 'goat' || newData.val() === 'sheep'" },
        "gender":  { ".validate": "newData.val() === 'male' || newData.val() === 'female'" }
      }
    },

    "health": {
      ".read":  "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChild('animal_tag') && newData.hasChild('diagnosis') && newData.hasChild('date')"
      }
    },

    "vaccinations": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "vaccination_templates": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "breeding": {
      ".read":  "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChild('female_breed')"
      }
    },

    "production_log": {
      ".read":  "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChild('type') && newData.hasChild('date') && newData.hasChild('quantity')",
        "type":     { ".validate": "newData.val() === 'milk' || newData.val() === 'wool' || newData.val() === 'weight'" },
        "quantity": { ".validate": "newData.isNumber() && newData.val() > 0" }
      }
    },

    "daily_tasks": {
      ".read":  "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChild('title') && newData.hasChild('date')",
        "status": { ".validate": "!newData.exists() || newData.val() === 'pending' || newData.val() === 'in_progress' || newData.val() === 'done'" }
      }
    },

    "inventory_meds": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "inventory_feeds": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Added: referenced by pages/inventory.js (fbTable mapping for
    //    type 'equip') and animals.html's bulk-reset table list. Was
    //    missing entirely -> every read/write fell through to $other
    //    -> 401, which is the exact error reported. ──────────────────
    "inventory_equipment": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Added: write-once transaction log created by shared.js's
    //    recordInventoryTransaction() (Inventory Transaction Engine
    //    v1.7). Purely additive per its own header comment; was never
    //    added to rules when that feature shipped. ──────────────────
    "inventory_transactions": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "feed_consumption": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "weight_log": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Added: settings.html's _deleteTable('weights') targets this
    //    top-level path, but per DATA_MODEL.md the certified SSOT for
    //    weight is the NESTED animals/{id}/weights, not a top-level
    //    collection -- this path is very likely always empty in the
    //    real database. Included for audit completeness (nothing in
    //    the app should ever 401), but flagged here since the reset
    //    button referencing it may itself be a naming leftover worth
    //    a separate look -- not something this rules-only change
    //    attempts to fix. ────────────────────────────────────────────
    "weights": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Added: the dashboard's Predictive Intelligence Engine reads
    //    these three directly by name. All three were completely
    //    absent from rules -> $other -> 401, matching the reported
    //    console errors exactly. ───────────────────────────────────
    "weight_alerts": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "production_alerts": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "workflow_history": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "notifications": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "activity": {
      ".read":  "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChild('action') && newData.hasChild('collection')"
      }
    },

    "activity_log": {
      ".read":  "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "!data.exists()"
      }
    },

    // ── Sensitive: Finance — read stays app-wide (dashboard shows
    //    today's income/expense summary to every role, unconditionally),
    //    write restricted to admin only, matching ROLE_PERMS exactly
    //    (supervisor/vet/worker/visitor are never granted 'finance'). ──
    "finance": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'",
      "$id": {
        ".validate": "newData.hasChild('type') && newData.hasChild('amount') && newData.hasChild('date')",
        "type":   { ".validate": "newData.val() === 'income' || newData.val() === 'expense'" },
        "amount": { ".validate": "newData.isNumber() && newData.val() > 0" }
      }
    },

    // ── Accounting Engine (Phase 1): Chart of Accounts. Read open to any
    //    signed-in session (journal posting needs to resolve account
    //    names/types client-side); write restricted to admin only, same
    //    reasoning as finance/users -- account definitions are structural,
    //    not day-to-day data entry. ──────────────────────────────────────
    "accounts": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'",
      "$id": {
        ".validate": "newData.hasChild('code') && newData.hasChild('name_ar') && newData.hasChild('type')",
        "type": { ".validate": "newData.val() === 'ASSET' || newData.val() === 'LIABILITY' || newData.val() === 'EQUITY' || newData.val() === 'REVENUE' || newData.val() === 'EXPENSE'" },
        "normalBalance": { ".validate": "!newData.exists() || newData.val() === 'debit' || newData.val() === 'credit'" }
      }
    },

    // ── Accounting Engine (Phase 1): Journal Entries. Double-entry lines
    //    are embedded in the entry itself (one atomic write per posting,
    //    matching this app's established flat-collection/client-filter
    //    pattern -- see computeFinanceKPIs). Immutability is enforced
    //    right here at the rules level, not just client-side: once a
    //    given entry's status is 'POSTED', this rule blocks every further
    //    write to that same id, full stop -- corrections must post a new
    //    reversing entry (reversesJournalEntryId) instead of touching the
    //    original. ─────────────────────────────────────────────────────
    "journal_entries": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin' && (!data.exists() || data.child('status').val() !== 'POSTED')",
      "$id": {
        ".validate": "newData.hasChild('date') && newData.hasChild('lines') && newData.hasChild('status')",
        "status": { ".validate": "newData.val() === 'DRAFT' || newData.val() === 'POSTED' || newData.val() === 'REVERSED'" }
      }
    },

    // ── Accounting Engine (Phase 2): Source Documents. Once a document
    //    leaves DRAFT, its financial identity (type/date/total) can never
    //    change again -- only status/paidAmount/remainingAmount/
    //    appliedPayments may still move (payment application), which is
    //    exactly what the third clause below allows while still locking
    //    type/date/total. Corrections to a POSTED document happen by
    //    reversing its linked journal entry, never by editing this
    //    record's financial fields directly. ─────────────────────────────
    "source_documents": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin' && (!data.exists() || data.child('status').val() === 'DRAFT' || (newData.child('type').val() === data.child('type').val() && newData.child('date').val() === data.child('date').val() && newData.child('total').val() === data.child('total').val()))",
      "$id": {
        ".validate": "newData.hasChild('type') && newData.hasChild('date') && newData.hasChild('total') && newData.hasChild('operationId') && newData.hasChild('status')",
        "type": { ".validate": "newData.val() === 'sales_invoice' || newData.val() === 'purchase_invoice' || newData.val() === 'receipt' || newData.val() === 'payment' || newData.val() === 'expense_voucher' || newData.val() === 'transfer' || newData.val() === 'animal_sale' || newData.val() === 'animal_purchase' || newData.val() === 'inventory_purchase' || newData.val() === 'inventory_consumption' || newData.val() === 'labor_payment' || newData.val() === 'asset_purchase' || newData.val() === 'loan' || newData.val() === 'owner_capital' || newData.val() === 'owner_withdrawal'" },
        "status": { ".validate": "newData.val() === 'DRAFT' || newData.val() === 'POSTED' || newData.val() === 'PARTIALLY_PAID' || newData.val() === 'PAID' || newData.val() === 'OVERDUE' || newData.val() === 'VOID' || newData.val() === 'CANCELLED'" },
        "total": { ".validate": "newData.isNumber() && newData.val() > 0" }
      }
    },

    // ── Accounting Engine (Phase 3): Cash & Bank account registry. Each
    //    record only points at a real ledger account (linkedAccountId) --
    //    balances are always computed from journal_entries, never stored
    //    here, so there's nothing balance-shaped for this rule to have to
    //    protect beyond normal admin-only write. ────────────────────────
    "cash_bank_accounts": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'",
      "$id": {
        ".validate": "newData.hasChild('name') && newData.hasChild('type') && newData.hasChild('linkedAccountId')",
        "type": { ".validate": "newData.val() === 'cash' || newData.val() === 'bank'" }
      }
    },

    // ── Accounting Engine (Phase 4): Customer registry (Accounts
    //    Receivable). Sales invoices themselves live in source_documents
    //    (type 'sales_invoice') -- this is only the customer master. ────
    "customers": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'",
      "$id": {
        ".validate": "newData.hasChild('name')"
      }
    },

    // ── Accounting Engine (Phase 5): Supplier registry (Accounts
    //    Payable). Purchase bills themselves live in source_documents
    //    (type 'purchase_invoice') -- this is only the supplier master.
    "suppliers": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'",
      "$id": {
        ".validate": "newData.hasChild('name')"
      }
    },

    // ── Accounting Engine (Phase 7): Animal Cost Ledger. A pure,
    //    write-once append log (never edited or deleted -- exactly like
    //    activity_log) of real, evidenced costs attributed to one animal.
    //    postAnimalSale/postAnimalDeath read this to decide whether a
    //    Cost of Animal Sales / Loss on Livestock leg is even postable. ──
    "animal_cost_ledger": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'",
      "$id": {
        ".validate": "newData.hasChild('animalId') && newData.hasChild('costType') && newData.hasChild('amount') && (!data.exists())",
        "amount": { ".validate": "newData.isNumber() && newData.val() > 0" }
      }
    },

    // ── Accounting Engine (Phase 8): Cost Centers + Cost Allocations.
    //    Allocations are a management-reporting attribution layer over
    //    already-posted, immutable journal entries -- write-once, like
    //    animal_cost_ledger, since re-allocating the same source entry
    //    under the same operationId should return the existing record,
    //    never silently overwrite a prior attribution. ──────────────────
    "cost_centers": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'",
      "$id": {
        ".validate": "newData.hasChild('name') && newData.hasChild('type')"
      }
    },
    "cost_allocations": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'",
      "$id": {
        ".validate": "newData.hasChild('sourceJournalEntryId') && newData.hasChild('totalAmount') && newData.hasChild('allocations') && (!data.exists())"
      }
    },

    // ── Accounting Engine (Phase 12): Employee registry (Labor Costing).
    //    Accruals/payments themselves live in source_documents (type
    //    'labor_payment') -- this is only the employee master. ─────────
    "employees": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'",
      "$id": {
        ".validate": "newData.hasChild('name')"
      }
    },

    // ── Accounting Engine (Phase 14): Fixed Asset register. Acquisition
    //    itself posts through source_documents (type 'asset_purchase');
    //    this is the asset master (acquisitionCost/usefulLifeMonths/
    //    residualValue) that postDepreciation reads to compute each
    //    period's straight-line amount. Accumulated depreciation is never
    //    stored here -- always derived from journal_entries. ────────────
    "fixed_assets": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'",
      "$id": {
        ".validate": "newData.hasChild('name') && newData.hasChild('acquisitionCost') && newData.hasChild('usefulLifeMonths')"
      }
    },

    // ── Users: read needed for the PIN-login screen (matches by pin_hash
    //    client-side); write restricted to admin only -- prevents any
    //    signed-in session from granting itself 'role':'admin' or
    //    overwriting another user's pin_hash. The `!data.exists()`
    //    fallback keeps Users.init()'s one-time bootstrap (creates the
    //    very first admin account on a brand-new, empty database) working
    //    even before any admin identity exists yet. ────────────────────
    "users": {
      ".read":  "auth != null",
      ".write": "(auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin') || !data.exists()",
      "$uid": {
        ".validate": "newData.hasChild('role') && newData.hasChild('name')"
      }
    },

    // ── uid_lookup: each signed-in identity may only read/write its OWN
    //    mapping entry -- stops one session from remapping another uid
    //    and inheriting/spoofing that user's resolved role elsewhere.
    //    firebase.js's own auth bootstrap writes here directly
    //    (fbPut('uid_lookup', _authUid, {appUserId})) to map a Firebase
    //    Anonymous-Auth UID to this app's own user id. ─────────────────
    "uid_lookup": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    // ── Settings: farm-wide configuration, admin-managed page in the
    //    app (settings.html isn't in any non-admin role's page list). ──
    "settings": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(root.child('uid_lookup').child(auth.uid).child('appUserId').val()).child('role').val() === 'admin'"
    },

    "diary_snapshot": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Added: the Farm Diary history redesign (this session) moved
    //    off the single diary_snapshot object onto a real dated
    //    collection, diary_snapshots/{YYYY-MM-DD}, written by
    //    shared.js's saveDiarySnapshot() and read by
    //    getLatestDiarySnapshot()/getDiarySnapshotByDate()/
    //    getDiarySnapshotsBetweenDates(). The old singular entry
    //    above is left as-is (harmless, matches whatever pre-existing
    //    data may still be there) -- only this new plural collection
    //    was actually missing. ──────────────────────────────────────
    "diary_snapshots": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "login_notifications": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Block everything else not listed ─────────────────────
    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}
